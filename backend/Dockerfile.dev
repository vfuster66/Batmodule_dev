# Dockerfile pour le développement backend
FROM node:18-alpine

WORKDIR /app

# Installation minimale pour PDFKit (beaucoup plus rapide que Puppeteer)
RUN apk add --no-cache \
    fontconfig \
    ttf-dejavu \
    && rm -rf /var/cache/apk/*

# Copier seulement les fichiers de dépendances d'abord (pour le cache Docker)
COPY package*.json ./

# Installer les dépendances (dev inclus pour le développement)
RUN npm install

# Copier seulement le code source nécessaire
COPY src ./src

# Exposer le port
EXPOSE 3000

# Commande de démarrage en mode développement
CMD ["npm", "run", "dev"]
